{
  "name": "@lit-pigeon/docs-examples",
  "private": true,
  "version": "0.0.0",
  "description": "Code examples from docs/guide, typechecked and tested against the built packages",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.vue.json && svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings",
    "test": "vitest run"
  },
