    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@lit-pigeon/blocks": "workspace:*",
    "@lit-pigeon/core": "workspace:*",
    "@lit-pigeon/editor": "workspace:*",
    "@lit-pigeon/import-unlayer": "workspace:*",
    "@lit-pigeon/lint": "workspace:*",
    "@lit-pigeon/parser-mjml": "workspace:*",
    "@lit-pigeon/react": "workspace:*",
    "@lit-pigeon/renderer-mjml": "workspace:*",
    "@lit-pigeon/rest": "workspace:*",
    "@lit-pigeon/ssr": "workspace:*",
    "@lit-pigeon/svelte": "workspace:*",
    "@lit-pigeon/vue": "workspace:*",
