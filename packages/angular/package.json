{
  "name": "@lit-pigeon/angular",
  "version": "0.1.6",
  "description": "Angular wrapper for the Pigeon email editor web component",
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "dev": "ng-packagr -p ng-package.json -c tsconfig.lib.json --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lit-pigeon/core": "workspace:^",
    "@lit-pigeon/editor": "workspace:^"
  },
  "peerDependencies": {
    "@angular/core": ">=22.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": false
    }
  },
  "devDependencies": {
    "@angular/compiler": "^22.1.7",
    "@angular/compiler-cli": "^22.1.7",
    "@angular/core": "^22.1.7",
    "ng-packagr": "^22.1.1",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/snxstudio/lit-pigeon.git",
    "directory": "packages/angular"
  },
  "license": "MIT",
  "homepage": "https://github.com/snxstudio/lit-pigeon/tree/main/packages/angular#readme",
  "bugs": "https://github.com/snxstudio/lit-pigeon/issues",
  "author": "Lit Pigeon Contributors",
  "keywords": [
    "email",
    "email-template",
    "email-editor",
    "mjml",
    "html-email",
    "lit",
    "web-components",
    "angular"
  ]
}
