<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="12px" color="#6b7280" />
    </mj-attributes>
    <mj-preview>Monthly shipping digest</mj-preview>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff">
      <mj-column>
        <mj-text font-size="14px" color="#111827"><p>Hello {{ first_name }},</p><p>Here is your digest for {{ month }}.</p><!-- digest body starts --></mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#111827" padding="24px 0">
      <mj-column>
        <mj-raw><!--[if mso]><table role="presentation" width="100%"><tr><td align="center" style="color:#ffffff"><![endif]--><!--[if !mso]><!--><div class="social-web" style="text-align:center"><!--<![endif]--></mj-raw>
        <mj-social mode="horizontal" icon-size="24px" align="center">
          <mj-social-element name="facebook" href="https://facebook.com/shipthis">Facebook</mj-social-element>
          <mj-social-element name="twitter" href="https://twitter.com/shipthis">X</mj-social-element>
          <mj-social-element name="instagram" href="https://instagram.com/shipthis">Instagram</mj-social-element>
          <mj-social-element href="https://shipthis.co" src="https://cdn.shipthis.co/icons/web.png">Website</mj-social-element>
        </mj-social>
        <mj-raw><!--[if !mso]><!--></div><!--<![endif]--><!--[if mso]></td></tr></table><![endif]--></mj-raw>
        <mj-text align="center" color="#9ca3af">Shipthis Technologies Pvt Ltd<br/>Andheri East, Mumbai 400069<br/><a href="{{ unsubscribe_url }}" style="color:#9ca3af">Unsubscribe</a> | <a href="https://shipthis.co/privacy" style="color:#9ca3af">Privacy</a><!--[if mso]><br/><span>Viewing in Outlook? <a href="{{ web_version_url }}">Open in browser</a></span><![endif]--></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
