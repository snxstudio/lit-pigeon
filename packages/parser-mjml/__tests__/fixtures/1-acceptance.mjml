<mjml><mj-head><mj-attributes><mj-all font-family="Nunito, Arial"/><mj-text color="#333333"/></mj-attributes><mj-style>.brand a { color:#0b5fff; }</mj-style><mj-preview>Your shipment update</mj-preview></mj-head>
<mj-body background-color="#f4f4f4" width="600px"><mj-wrapper padding="10px" background-color="#ffffff"><mj-section background-color="#0b2545" padding="20px 0"><mj-column><mj-image src="https://cdn.shipthis.co/logo.png" width="140px" href="https://shipthis.co" alt="Shipthis"/></mj-column></mj-section></mj-wrapper>
<mj-section><mj-column width="100%"><mj-text font-size="16px" css-class="brand">Hi {{ customer_name }},<br/>Your shipment <b>{{ shipment_no }}</b> has departed <a href="https://track.shipthis.co/{{ shipment_no }}">track here</a>.</mj-text><mj-button background-color="#0b5fff" href="https://app.shipthis.co/s/{{ id }}">View shipment</mj-button><mj-divider border-color="#dddddd"/><mj-spacer height="20px"/></mj-column></mj-section>
<mj-section><mj-group><mj-column width="50%"><mj-text>ETD: {{ etd }}</mj-text></mj-column><mj-column width="50%"><mj-text>ETA: {{ eta }}</mj-text></mj-column></mj-group></mj-section>
<mj-section><mj-column><mj-table><tr><td>Container</td><td>{{ container_no }}</td></tr></mj-table><mj-social mode="horizontal"><mj-social-element name="linkedin" href="https://linkedin.com/company/shipthis">LinkedIn</mj-social-element></mj-social><mj-raw><p style="font-size:10px">Unsubscribe {{ unsubscribe_link }}</p></mj-raw></mj-column></mj-section></mj-body></mjml>
